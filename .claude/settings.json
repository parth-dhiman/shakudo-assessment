{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit(**)",
      "Read(**)",
      "Bash(npm *)",
      "Bash(git add *)",
      "Bash(git status)"
    ],
  "deny": [
      "Bash(minikube delete *)",
      "Bash(minikube stop *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git reset *--hard*)",
      "Bash(git rebase *)",
      "Bash(git commit *--amend*)",
      "Bash(git clean *)"
    ]
  }
}
